# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=

# ── AI (set as Supabase secret, NOT a VITE_ variable — never expose to browser)
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# ── Fitness plan generation config (set as Supabase secrets) ──────────────────
# AI model used for plan generation (default: claude-sonnet-4-6)
AI_MODEL=claude-sonnet-4-6
# Prompt schema version — increment when system prompt changes significantly
FITNESS_PROMPT_VERSION=1
# Calorie calculation formula version — increment when formulas change
CALORIE_CALCULATION_VERSION=1
